#!/usr/bin/python3
# -*- coding: utf-8 -*-

DATA_DIR = "@pkgdatadir@"

RECORD_DIR = "@pkglocalstatedir@"
RECORD_PREFIX = "recording"
RECORD_SUFFIX = ".wav"

RING_FILE = DATA_DIR + "/ring.wav"
DIAL_FILE = DATA_DIR + "/dial.wav"
STARTUP_FILE = DATA_DIR + "/startup.wav"
SHUTDOWN_FILE = DATA_DIR + "/shutdown.wav"

RECORD_LIST_FILE = "@pkglocalstatedir@/records.list"
BACKUP_EXT = ".bak"

UPLOAD_DIR = RECORD_DIR

WEBAPP_EXEC = ("python3", "-m", "telefono.webapp")

FLASK_DEBUG = True
FLASK_IP = "0.0.0.0"
FLASK_PORT = 5000
FLASK_TEMPLATES = "@templatedir@"

MIN_HOUR = 15
MAX_HOUR = 21

MOAN_PROPABILITY = 0.1
