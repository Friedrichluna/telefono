#!/usr/bin/python3
# -*- coding: utf-8 -*-

DATA_DIR = "@pkgdatadir@"

RECORD_DIR = "@pkglocalstatedir@"
RECORD_PREFIX = "recording"
RECORD_SUFFIX = ".wav"

RING_FILE = DATA_DIR + "/ring.wav"
STARTUP_FILE = DATA_DIR + "/startup.wav"
SHUTDOWN_FILE = DATA_DIR + "/shutdown.wav"

RECORD_LIST_FILE = "@pkglocalstatedir@/records.list"
BACKUP_EXT = ".bak"

UPLOAD_DIR = RECORD_DIR

WEBAPP_EXEC = ("python3", "-m", "telefono.webapp")

FLASK_DEBUG = True
FLASK_IP = "0.0.0.0"
FLASK_PORT = 5000
FLASK_TEMPLATES = "@templatedir@"

MIN_HOUR = 15
MAX_HOUR = 21

MOAN_PROPABILITY = 0.1

SOX_BASE = ("play", "-n")
SOX_VOL = ("vol", "-20dB")
SOX_REMIX =  ("remix", "-")
SOX_REPEAT =  ("repeat", "-")

SOX_DIAL = (*SOX_BASE,
            "synth",
            "sin", "350",
            "sin", "440",
            *SOX_VOL, *SOX_REMIX)

SOX_BUSY = (*SOX_BASE,
            "synth", "0.5",
            "sin", "425",
            "pad", "0", "0.5",
            *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_RING = (*SOX_BASE,
            "synth", "1",
            "sin", "425",
            "pad", "0", "4",
            *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_RELEASE = (*SOX_BASE,
               "synth", "0.25",
               "sin", "425",
               "pad", "0", "0.25",
               *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_DIAL_SECONDARY = SOX_DIAL

SOX_DIAL_SPECIAL = (*SOX_BASE,
                    "synth", "0.5",
                    "sin", "425",
                    "pad", "0", "0.05",
                    *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_SIT = (*SOX_BASE,
           "synth", "0.33",
           "sin", "950",
           "sin", "1400",
           "sin", "1800",
           "delay", "0", "0.33", "0.66",
           "pad", "0", "1",
           *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_CONGESTION = (*SOX_BASE,
                  "synth", "0.25",
                  "sin", "425",
                  "pad", "0", "0.25",
                  *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_CALL_WAIT = (*SOX_BASE,
                 "synth", "0.2",
                 "sin", "425",
                 "sin", "425",
                 "delay", "0" "0.4"
                 "pad", "0", "9",
                 *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)


NO_NUMBER_DELAY = 0.01
NO_NUMBER_TIMEOUT = 60 / NO_NUMBER_DELAY
