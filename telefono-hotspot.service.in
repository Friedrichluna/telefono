[Unit]
Description=Telefono: WLAN hotspot when no known WLAN is in range
After=NetworkManager.service

[Service]
# root: NetworkManager connections, iw scan and the password file
ExecStart=python3 @pkglibexecdir@/telefono-net hotspot
RuntimeDirectory=telefono-hotspot
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
