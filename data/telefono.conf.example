# telefono hardware configuration of one phone
#
# Copy this file to telefono.conf in the same directory (usually
# /etc/telefono.conf) and adjust it there, it is not overwritten by
# updates. Without the file nothing is inverted.
#
# The phones are wired differently: an input that reads "pressed" at
# rest (handset on the hook, buttons released, dial not turned) has to
# be inverted, and so has the loudspeaker relay if it is on while it
# should be off. Values: yes or no, a missing entry means no.
#
# After a change: sudo systemctl restart telefono
# The journal shows what was read: journalctl -u telefono | grep inverted

[inverted]
# handset lifted (GPIO 18)
hook = no
# left button (GPIO 3)
left = no
# middle button (GPIO 27), held for 5 s it shuts telefono down
middle = no
# dial pulse counter (GPIO 2)
dial_counter = no
# dial is turned (GPIO 26)
dial_in_use = no
# loudspeaker switch (GPIO 17), inverting swaps loud and quiet
speaker_switch = no
# loudspeaker relay (GPIO 4, output, powers the loudspeaker's amplifier):
# no = low is on, yes = high is on
speaker_relay = no

# Finding the webapp (telefono-mdns and telefono-hotspot services), read
# again within seconds, no restart needed. The defaults are shown.
[network]
# name in the network: http://<name>.local:5000, in addition to
# http://<hostname>.local:5000. With several phones in one network give
# each its own name, otherwise the second one gets telefono-2.local.
#name = telefono
# own WLAN (access point) when no known WLAN is in range for 90 s,
# back to the known WLAN when it is in range and nobody uses the hotspot
#hotspot = yes
# name of that WLAN (default telefono-<hostname>); its password is in
# /etc/telefono-hotspot.conf (made at the first start, root only)
#hotspot_ssid = telefono-pi
