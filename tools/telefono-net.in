#!/usr/bin/python3
# -*- coding: utf-8 -*-

# telefono-net: makes the webapp of a phone easy to find
#
#   telefono-net mdns      publishes <name>.local (default telefono.local)
#                          with the IPv4 address of every interface, in
#                          addition to <hostname>.local (avahi over D-Bus,
#                          telefono-mdns.service)
#   telefono-net hotspot   turns the WLAN into an open access point when
#                          no known WLAN is in range and goes back to a
#                          known WLAN as soon as it is in range again and
#                          nobody uses the hotspot (NetworkManager,
#                          telefono-hotspot.service, runs as root),
#                          answers every name and every http request in
#                          that WLAN with the webapp (captive portal)
#                          and saves or deletes known WLANs for the
#                          webapp (page WLAN)
#
# Settings: section [network] of telefono.conf (see telefono.conf.example),
# read again on every check. For the status page of the webapp each one
# writes its state to /run/telefono-<command>/state.json.
#
# Standalone on purpose: importing the telefono package would load the
# GPIO and audio modules.

import argparse
import configparser
import http.server
import json
import logging
import os
import re
import signal
import socket
import stat
import subprocess
import sys
import threading
import time


CONFIG_FILE = "@sysconfdir@/telefono.conf"

MDNS_STATE_FILE = "/run/telefono-mdns/state.json"
HOTSPOT_STATE_FILE = "/run/telefono-hotspot/state.json"

# the names of the phone and the captive portal for the devices in the
# hotspot (read by the dnsmasq NetworkManager starts for the hotspot)
DNSMASQ_FILE = "/etc/NetworkManager/dnsmasq-shared.d/telefono.conf"

DEFAULT_NAME = "telefono"

# mDNS: interfaces and addresses are checked every MDNS_TICK s
MDNS_TICK = 5

# hotspot: the WLAN is checked every HOTSPOT_TICK s; without a known
# WLAN for HOTSPOT_DELAY s (after the start or after losing it) the
# hotspot is started; in the hotspot, every HOTSPOT_CHECK s a known WLAN
# is looked for if no device is connected to the hotspot
HOTSPOT_TICK = 15
HOTSPOT_DELAY = 90
HOTSPOT_CHECK = 180
# without NetworkManager or WLAN only every IDLE_TICK s
IDLE_TICK = 60
# a failed hotspot start is retried after HOTSPOT_DELAY, doubled up to
HOTSPOT_RETRY_MAX = 1800

HOTSPOT_CONNECTION = "telefono-hotspot"
HOTSPOT_ADDRESS = "10.42.0.1"
HOTSPOT_PREFIX = 24

# the captive portal of the hotspot: port 80 answers every request with
# a redirect to the webapp, so the device that joins the WLAN opens it
# by itself ("sign in to the network"). WEBAPP_PORT is FLASK_PORT of
# src/CONSTANTS.py.in, PORTAL_URL what the devices are sent to.
WEBAPP_PORT = 5000
PORTAL_PORT = 80
PORTAL_URL = "http://%s:%d/" % (HOTSPOT_ADDRESS, WEBAPP_PORT)
# the modes (state file) in which the phone is its own access point and
# the portal runs
PORTAL_MODES = ("hotspot", "hotspot starting")

# after the hotspot is stopped: NetworkManager gets up to SWITCH_WAIT s
# to connect a known WLAN by itself (checked every SWITCH_POLL s), less if
# it does not start connecting within SWITCH_IDLE s
SWITCH_WAIT = 30
SWITCH_IDLE = 6
SWITCH_POLL = 2

# timeouts (s) of nmcli commands that activate something
ACTIVATE_TIMEOUT = 45
DEACTIVATE_TIMEOUT = 20

STATE_REWRITE = 60

# WLANs saved or deleted on the webapp's page WLAN: the webapp (user of
# telefono.service) writes a request to its runtime directory, the
# hotspot service (root, it may change NetworkManager's connections)
# looks for it every REQUEST_POLL s, does it and puts the answer into
# its state file. A new WLAN is connected NEW_WLAN_DELAY s later if the
# phone is in the hotspot or has no WLAN (so the answer still reaches
# the browser first).
REQUEST_FILE = "/run/telefono/wifi-request.json"
REQUEST_MAX = 4096
REQUEST_POLL = 1
NEW_WLAN_DELAY = 5
# the known and visible WLANs in the state file are updated every
# LISTS_REFRESH s and after every request
LISTS_REFRESH = 60
VISIBLE_MAX = 30

log = logging.getLogger ("telefono-net")


warned = set ()


# a configuration problem is logged once, not on every check
def warn_once (message:str, *args):
	text = message % args
	if text not in warned:
		warned.add (text)
		log.warning ("%s", text)
	return


def short_hostname () -> str:
	return socket.gethostname ().split (".")[0]


NAME_PATTERN = re.compile (r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")


# the [network] section: {"name": mDNS name without .local,
# "hotspot": bool, "ssid": SSID of the hotspot, the name by default};
# missing or invalid entries are the defaults, a broken file never stops
# anything
def read_config (path:str=CONFIG_FILE) -> dict:
	# the early returns below keep the default of both
	result = {"name": DEFAULT_NAME, "hotspot": True, "ssid": DEFAULT_NAME}

	config = configparser.ConfigParser ()
	try:
		config.read (path, encoding="utf-8")
	except (configparser.Error, UnicodeDecodeError) as error:
		warn_once ("%s is invalid, using the defaults: %s", path, error)
		return result

	if not config.has_section ("network"):
		return result

	section = config["network"]

	name = section.get ("name", "").strip ().lower ()
	if name.endswith (".local"):
		name = name[:-len (".local")]
	if name:
		if NAME_PATTERN.match (name):
			result["name"] = name
		else:
			warn_once ("%s: name = %s is not a valid name (letters, digits"
			           " and -), using %s", path, name, DEFAULT_NAME)

	try:
		result["hotspot"] = section.getboolean ("hotspot", True)
	except ValueError:
		warn_once ("%s: hotspot = %s is neither yes nor no, using yes",
		           path, section.get ("hotspot"))

	# the WLAN carries the name of the phone, so its WLAN and the
	# address of its webapp are the same word
	result["ssid"] = result["name"]

	ssid = section.get ("hotspot_ssid", "").strip ()
	if ssid:
		if len (ssid.encode ()) <= 32:
			result["ssid"] = ssid
		else:
			warn_once ("%s: hotspot_ssid is longer than 32 bytes, using %s",
			           path, result["name"])

	return result


class StateFile ():
	def __init__ (self, path:str):
		self.path = path
		self.written = None
		self.time = 0
		return

	# written when it changed and every STATE_REWRITE s (so the status
	# page sees that the service is alive)
	def write (self, state:dict):
		now = time.time ()
		if state == self.written and now - self.time < STATE_REWRITE:
			return

		data = dict (state, updated=now)
		temp = self.path + ".tmp"
		try:
			with open (temp, "w", encoding="utf-8") as f:
				json.dump (data, f, ensure_ascii=False)
			os.chmod (temp, 0o644)
			os.replace (temp, self.path)
		except OSError as error:
			warn_once ("writing %s failed: %s", self.path, error)
			return

		self.written = state
		self.time = now
		return


#
# mDNS
#

AVAHI = "org.freedesktop.Avahi"
AVAHI_IF_UNSPEC = -1
# protocol = the mDNS transport (IPv4 and IPv6 multicast), not the
# address family: Windows asks over IPv6 too
AVAHI_PROTO_UNSPEC = -1
# no PTR record: the reverse name of the address stays <hostname>.local
AVAHI_PUBLISH_NO_REVERSE = 16
AVAHI_SERVER_RUNNING = 2
GROUP_STATES = {0: "uncommitted", 1: "registering", 2: "established",
                3: "collision", 4: "failure"}
GROUP_COLLISION = 3
GROUP_FAILURE = 4


# {interface: first IPv4 address} of the interfaces that are up, without
# loopback
def interface_addresses () -> dict:
	import psutil

	stats = psutil.net_if_stats ()
	result = dict ()
	for name, addresses in psutil.net_if_addrs ().items ():
		if "lo" == name or name not in stats or not stats[name].isup:
			continue

		for address in addresses:
			if socket.AF_INET == address.family \
			and not address.address.startswith ("127."):
				result[name] = address.address
				break

	return result


class Mdns ():
	def __init__ (self):
		import dbus
		self.dbus = dbus
		self.bus = None
		self.owner = None
		self.server = None
		self.group = None
		self.wanted = None
		self.name = None
		self.published = None
		self.state = StateFile (MDNS_STATE_FILE)
		return

	def reset (self):
		self.server = None
		self.group = None
		self.published = None
		return

	def connect (self):
		dbus = self.dbus
		if self.bus is None:
			self.bus = dbus.SystemBus ()

		owner = self.bus.get_name_owner (AVAHI)
		if owner != self.owner or self.server is None:
			# avahi-daemon was (re)started: our old entry group is gone
			self.reset ()
			self.owner = owner
			self.server = dbus.Interface (self.bus.get_object (AVAHI, "/"),
			                              AVAHI + ".Server")
		return

	def new_group (self):
		path = self.server.EntryGroupNew ()
		self.group = self.dbus.Interface (self.bus.get_object (AVAHI, path),
		                                  AVAHI + ".EntryGroup")
		return

	# publishes self.name.local with the address of each interface on
	# that interface (eth0 and wlan0 can be in the same network, each
	# answers with its own address, like avahi does for the hostname)
	def publish (self, addresses:dict):
		dbus = self.dbus

		for attempt in range (10):
			if self.group is None:
				self.new_group ()
			else:
				self.group.Reset ()

			fqdn = self.name + ".local"
			try:
				for interface, address in sorted (addresses.items ()):
					try:
						index = socket.if_nametoindex (interface)
					except OSError:
						continue

					self.group.AddAddress (dbus.Int32 (index),
					                       dbus.Int32 (AVAHI_PROTO_UNSPEC),
					                       dbus.UInt32 (AVAHI_PUBLISH_NO_REVERSE),
					                       fqdn, address)
			except dbus.exceptions.DBusException as error:
				# another name of this host (or one of its services)
				if "CollisionError" not in (error.get_dbus_name () or ""):
					raise
				self.rename ("local collision")
				continue

			if not self.group.IsEmpty ():
				self.group.Commit ()
				log.info ("publishing %s: %s", fqdn,
				          ", ".join ("%s %s" % item
				                     for item in sorted (addresses.items ())))
			else:
				log.info ("%s: no address to publish", fqdn)
			return

		raise RuntimeError ("no free name found for %s" % self.wanted)

	def rename (self, reason:str):
		old = self.name
		self.name = str (self.server.GetAlternativeHostName (self.name))
		log.warning ("%s.local is used by another device (%s), now %s.local",
		             old, reason, self.name)
		return

	def tick (self):
		config = read_config ()
		hostname = short_hostname ()
		state = {"wanted": config["name"], "hostname": hostname}

		if config["name"] != self.wanted:
			self.wanted = config["name"]
			self.name = self.wanted
			self.published = None

		addresses = interface_addresses ()
		try:
			if self.name == hostname:
				# <hostname>.local is published by avahi itself
				if self.group is not None and self.published is not None:
					self.group.Reset ()
				self.published = None
				state.update (state="hostname", name=self.name)
				self.state.write (state)
				return

			self.connect ()

			if self.server.GetState () != AVAHI_SERVER_RUNNING:
				# a host name conflict of avahi itself resets everything
				self.reset ()
				state.update (state="avahi not ready")
				self.state.write (state)
				return

			if self.group is not None and self.published is not None:
				group_state = self.group.GetState ()
				if GROUP_COLLISION == group_state:
					self.rename ("collision")
					self.published = None
				elif GROUP_FAILURE == group_state:
					log.warning ("publishing %s.local failed, trying again",
					             self.name)
					self.published = None

			key = (self.name, tuple (sorted (addresses.items ())))
			if key != self.published:
				self.publish (addresses)
				self.published = key

			group_state = GROUP_STATES.get (self.group.GetState (), "?")
		except self.dbus.exceptions.DBusException as error:
			warn_once ("avahi is not reachable: %s", error.get_dbus_message ()
			           or error)
			self.reset ()
			state.update (state="no avahi")
			self.state.write (state)
			return

		if not addresses:
			group_state = "no address"

		state.update (state=group_state, name=self.name,
		              addresses=addresses)
		self.state.write (state)
		return


def run_mdns (args) -> int:
	try:
		publisher = Mdns ()
	except ImportError:
		log.error ("python3-dbus is missing (sudo apt install python3-dbus),"
		           " %s.local is not published", DEFAULT_NAME)
		StateFile (MDNS_STATE_FILE).write ({"state": "no dbus"})
		return 0

	log.info ("started")
	while True:
		try:
			publisher.tick ()
		except Exception:
			log.exception ("mDNS check failed")
			publisher.reset ()
		time.sleep (MDNS_TICK)


#
# hotspot
#

def run_command (command:list, timeout:float=60):
	# English messages, but SSIDs with umlauts as they are (with "C"
	# nmcli prints "?" for them)
	env = dict (os.environ, LC_ALL="C.UTF-8")
	try:
		result = subprocess.run (command, capture_output=True, text=True,
		                         timeout=timeout, env=env)
	except FileNotFoundError:
		return 127, "", "%s not found" % command[0]
	except subprocess.TimeoutExpired:
		return 124, "", "%s timed out" % " ".join (command[:4])

	return result.returncode, result.stdout, result.stderr


# fields of a line of nmcli -t (":" separated, "\:" and "\\" escaped)
def terse_fields (line:str) -> list:
	fields = list ()
	field = ""
	escaped = False
	for c in line:
		if escaped:
			field += c
			escaped = False
		elif "\\" == c:
			escaped = True
		elif ":" == c:
			fields.append (field)
			field = ""
		else:
			field += c

	fields.append (field)
	return fields


class NetworkManager ():
	def __init__ (self, run=run_command, nmcli:str="nmcli", iw:str="iw"):
		self.run = run
		self.nmcli = nmcli
		self.iw = iw
		return

	def nm (self, *args, timeout:float=30):
		return self.run ([self.nmcli, *args], timeout=timeout)

	# [{device, type, state, connection}], None if NetworkManager
	# does not run (or nmcli is missing)
	def devices (self):
		code, out, _ = self.nm ("-t", "-f", "DEVICE,TYPE,STATE,CONNECTION",
		                        "device")
		if code:
			return None

		devices = list ()
		for line in out.splitlines ():
			fields = terse_fields (line)
			if len (fields) < 4:
				continue
			devices.append ({"device": fields[0], "type": fields[1],
			                 "state": fields[2], "connection": fields[3]})
		return devices

	# values of the settings of a connection (tuple in the order of
	# names), None if it does not exist; "uuid" is a UUID or "id NAME"
	def settings (self, uuid:str, names:tuple, show_secrets:bool=False):
		key = ["id", uuid[3:]] if uuid.startswith ("id ") else ["uuid", uuid]
		code, out, _ = self.nm (*(["-s"] if show_secrets else []), "-t", "-f",
		                        ",".join (names), "connection", "show", *key)
		if code:
			return None

		# one "name:value" line per setting, the value is not escaped
		values = dict ()
		for line in out.splitlines ():
			name, separator, value = line.partition (":")
			if separator:
				values[name] = value
		return tuple (values.get (name, "") for name in names)

	# known WLANs NetworkManager connects to by itself: [(uuid, ssid)],
	# the wifi connections in infrastructure mode with autoconnect for
	# this device (or any device), without the hotspot
	def known_networks (self, device:str) -> list:
		code, out, _ = self.nm ("-t", "-f", "NAME,UUID,TYPE", "connection",
		                        "show")
		if code:
			return []

		known = list ()
		for line in out.splitlines ():
			fields = terse_fields (line)
			if len (fields) < 3 or fields[2] != "802-11-wireless" \
			or HOTSPOT_CONNECTION == fields[0]:
				continue

			values = self.settings (fields[1], ("802-11-wireless.ssid",
			                                    "802-11-wireless.mode",
			                                    "connection.autoconnect",
			                                    "connection.interface-name"))
			if values is None:
				continue

			ssid, mode, autoconnect, interface = values
			if mode not in ("", "infrastructure") or "yes" != autoconnect \
			or interface not in ("", device) or not ssid:
				continue

			known.append ((fields[1], ssid))
		return known

	# {ssid: signal} of the WLANs in range (NetworkManager's scan)
	def visible (self, device:str, rescan:bool=True) -> dict:
		code, out, _ = self.nm ("-t", "-f", "SSID,SIGNAL", "device", "wifi",
		                        "list", "ifname", device, "--rescan",
		                        "yes" if rescan else "no", timeout=60)
		if code and rescan:
			# e.g. no scan allowed right now: the last results
			code, out, _ = self.nm ("-t", "-f", "SSID,SIGNAL", "device",
			                        "wifi", "list", "ifname", device,
			                        "--rescan", "auto", timeout=60)
		result = dict ()
		if code:
			return result

		for line in out.splitlines ():
			fields = terse_fields (line)
			if len (fields) < 2 or not fields[0]:
				continue
			try:
				signal = int (fields[1])
			except ValueError:
				signal = 0
			result[fields[0]] = max (signal, result.get (fields[0], 0))
		return result

	# SSIDs in range while the device is an access point, None if the
	# driver can not scan then
	def ap_scan (self, device:str):
		code, out, _ = self.run ([self.iw, "dev", device, "scan", "ap-force"],
		                         timeout=30)
		if code:
			return None

		return {line.strip ()[len ("SSID: "):] for line in out.splitlines ()
		        if line.strip ().startswith ("SSID: ")}

	# number of devices connected to the hotspot, None if unknown
	def stations (self, device:str):
		code, out, _ = self.run ([self.iw, "dev", device, "station", "dump"],
		                         timeout=10)
		if code:
			return None

		return sum (1 for line in out.splitlines ()
		            if line.startswith ("Station "))

	# saves a WLAN NetworkManager connects to by itself (password ""
	# is an open WLAN); True or the error of nmcli
	def save_network (self, device:str, ssid:str, password:str,
	                  uuid:str=None):
		if password:
			security = ["wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk",
			            password]
		elif uuid:
			security = ["remove", "802-11-wireless-security"]
		else:
			security = []

		if uuid:
			code, _, err = self.nm ("connection", "modify", "uuid", uuid,
			                        "connection.autoconnect", "yes",
			                        *security)
		else:
			code, _, err = self.nm ("connection", "add", "type", "wifi",
			                        "ifname", device, "con-name", ssid,
			                        "ssid", ssid, "connection.autoconnect",
			                        "yes", *security)
		return True if not code else err.strip () or "nmcli: %d" % code

	def delete_network (self, uuid:str):
		code, _, err = self.nm ("connection", "delete", "uuid", uuid)
		return True if not code else err.strip () or "nmcli: %d" % code

	def up (self, uuid:str, device:str) -> bool:
		code, _, err = self.nm ("--wait", str (ACTIVATE_TIMEOUT), "connection",
		                        "up", "uuid", uuid, "ifname", device,
		                        timeout=ACTIVATE_TIMEOUT + 15)
		if code:
			log.info ("connecting %s failed: %s", uuid, err.strip ())
		return not code

	# the hotspot connection: (ssid, key management, interface) or None
	# (the key management of the open hotspot is "", see make_hotspot)
	def hotspot_settings (self):
		return self.settings ("id " + HOTSPOT_CONNECTION,
		                      ("802-11-wireless.ssid",
		                       "802-11-wireless-security.key-mgmt",
		                       "connection.interface-name"))

	def delete_hotspot (self):
		code, _, _ = self.nm ("connection", "delete", "id", HOTSPOT_CONNECTION)
		return not code

	# the hotspot is an in-memory connection (nothing written to
	# /etc/NetworkManager or /etc/netplan), made again after every start
	# of NetworkManager; without autoconnect, so NetworkManager itself
	# never starts it, only this script.
	# It has no password: whoever stands next to the phone shall reach
	# its webapp without being told a key first (and the webapp is not
	# protected either). Everything in that WLAN is therefore readable
	# by everyone in range, so no key management at all (an open AP),
	# not WPA with a known password.
	def make_hotspot (self, device:str, ssid:str) -> bool:
		if self.hotspot_settings () == (ssid, "", device):
			return True

		self.delete_hotspot ()
		code, _, err = self.nm (
		        "connection", "add", "save", "no",
		        "type", "wifi", "ifname", device,
		        "con-name", HOTSPOT_CONNECTION, "autoconnect", "no",
		        "ssid", ssid,
		        "802-11-wireless.mode", "ap",
		        "802-11-wireless.band", "bg",
		        "ipv4.method", "shared",
		        "ipv4.addresses", "%s/%d" % (HOTSPOT_ADDRESS, HOTSPOT_PREFIX),
		        "ipv6.method", "disabled")
		if code:
			log.error ("making the hotspot connection failed: %s", err.strip ())
		return not code

	def hotspot_up (self, device:str) -> bool:
		code, _, err = self.nm ("--wait", str (ACTIVATE_TIMEOUT), "connection",
		                        "up", "id", HOTSPOT_CONNECTION, "ifname", device,
		                        timeout=ACTIVATE_TIMEOUT + 15)
		if code:
			log.error ("starting the hotspot failed: %s", err.strip ())
		return not code

	# down, and NetworkManager may connect the device to known WLANs
	# again by itself (a "nmcli device disconnect" would forbid that)
	def hotspot_down (self, device:str):
		self.nm ("--wait", str (DEACTIVATE_TIMEOUT), "connection", "down",
		         "id", HOTSPOT_CONNECTION, timeout=DEACTIVATE_TIMEOUT + 10)
		self.nm ("device", "set", device, "autoconnect", "yes")
		return


# a WPA passphrase (the WLANs of the page WLAN; the hotspot of the phone
# itself has none)
def valid_password (password:str) -> bool:
	return 8 <= len (password) <= 63 \
	       and all (32 <= ord (c) < 127 for c in password)


# what the dnsmasq of the hotspot tells the devices in it: the names of
# the phone (some phones do not ask mDNS for .local names), every other
# name as well (address=/#/, so a browser reaches the webapp whatever it
# asks for and the captive portal is found, see Portal) and the address
# of the portal in the DHCP lease (option 114, RFC 8910: newer phones
# open it without any detection)
def write_dnsmasq (name:str, path:str=DNSMASQ_FILE):
	text = ("# written by telefono-hotspot: this phone for the devices in"
	        " its hotspot\naddress=/%s.local/%s\naddress=/%s/%s\n"
	        "address=/#/%s\ndhcp-option=114,%s\n"
	        % (name, HOTSPOT_ADDRESS, name, HOTSPOT_ADDRESS,
	           HOTSPOT_ADDRESS, PORTAL_URL))
	try:
		with open (path, encoding="utf-8") as f:
			if f.read () == text:
				return
	except OSError:
		pass

	try:
		if not os.path.isdir (os.path.dirname (os.path.dirname (path))):
			return
		os.makedirs (os.path.dirname (path), exist_ok=True)
		with open (path + ".tmp", "w", encoding="utf-8") as f:
			f.write (text)
		os.replace (path + ".tmp", path)
	except OSError as error:
		warn_once ("writing %s failed: %s", path, error)
	return


# The captive portal of the hotspot: port 80 of the phone, answering
# every request with a redirect to the webapp. The devices in an open
# WLAN check whether they have internet by fetching a well known http
# page (connectivitycheck.gstatic.com, captive.apple.com,
# msftconnecttest.com, ...); dnsmasq points every name at the phone
# (write_dnsmasq), so those checks land here, the redirect tells the
# device that it is behind a portal and it opens the webapp by itself.
# Only in the hotspot: in a known WLAN port 80 belongs to whatever else
# runs there, so the server is started with the hotspot and stopped with
# it.
class Portal ():
	def __init__ (self, url:str=PORTAL_URL, port:int=PORTAL_PORT):
		self.url = url
		self.port = port
		self.server = None
		self.thread = None
		self.failed = False
		return

	def __handler (self):
		url = self.url

		class Handler (http.server.BaseHTTPRequestHandler):
			protocol_version = "HTTP/1.1"

			def do_GET (self):
				body = ("<!DOCTYPE html><html><head><meta charset=\"utf-8\">"
				        "<title>telefono</title><meta http-equiv=\"refresh\""
				        " content=\"0; url=%s\"></head><body>"
				        "<a href=\"%s\">%s</a></body></html>\n"
				        % (url, url, url)).encode ()

				# 302 and the address: that is what makes a device show
				# "sign in to the network" and open the page; the body is
				# for the browsers that show it instead of following
				self.send_response (302)
				self.send_header ("Location", url)
				self.send_header ("Content-Type", "text/html; charset=utf-8")
				self.send_header ("Content-Length", str (len (body)))
				self.send_header ("Cache-Control", "no-store")
				self.end_headers ()
				self.wfile.write (body)
				return

			def do_HEAD (self):
				self.send_response (302)
				self.send_header ("Location", url)
				self.send_header ("Content-Length", "0")
				self.send_header ("Cache-Control", "no-store")
				self.end_headers ()
				return

			def do_POST (self):
				self.do_GET ()
				return

			# the detection requests of every device would fill the
			# journal
			def log_message (self, format, *args):
				log.debug ("portal: " + format, *args)
				return

		return Handler

	# nothing happens if it already runs; a port 80 that is taken is
	# logged once (the hotspot works without the portal, the webapp is
	# still reachable at its address)
	def start (self):
		if self.server is not None or self.failed:
			return False

		try:
			self.server = http.server.ThreadingHTTPServer (("", self.port),
			                                               self.__handler ())
		except OSError as error:
			self.failed = True
			log.error ("no captive portal on port %d: %s", self.port, error)
			return False

		self.server.daemon_threads = True
		self.thread = threading.Thread (target=self.server.serve_forever,
		                                kwargs={"poll_interval": 0.5},
		                                name="portal", daemon=True)
		self.thread.start ()
		log.info ("captive portal on port %d points to %s", self.port,
		          self.url)
		return True

	def stop (self):
		# port 80 may be free again at the next hotspot
		self.failed = False

		if self.server is None:
			return

		self.server.shutdown ()
		self.server.server_close ()
		self.thread.join (timeout=5)
		self.server = None
		self.thread = None
		log.info ("captive portal stopped")
		return


def valid_wlan_password (password:str) -> bool:
	return "" == password or valid_password (password) \
	       or (64 == len (password)
	           and all (c in "0123456789abcdefABCDEF" for c in password))


# the request of the webapp, removed when read: {"id", "action" ("save"
# or "delete"), "ssid", "password"}, {"id", "invalid": reason} if it is
# not valid, None if there is none; the file belongs to the webapp's
# user, so no links, nothing but a small regular file
def take_request (path:str=REQUEST_FILE):
	try:
		fd = os.open (path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
	except FileNotFoundError:
		return None
	except OSError as error:
		warn_once ("reading %s failed: %s", path, error)
		try:
			os.unlink (path)
		except OSError:
			pass
		return None

	try:
		with os.fdopen (fd, "rb") as f:
			data = f.read (REQUEST_MAX + 1) \
			       if stat.S_ISREG (os.fstat (f.fileno ()).st_mode) else b""
	finally:
		try:
			os.unlink (path)
		except OSError:
			pass

	try:
		request = json.loads (data.decode ()) if len (data) <= REQUEST_MAX \
		          else None
	except (UnicodeDecodeError, ValueError):
		request = None
	if not isinstance (request, dict):
		return {"id": "", "invalid": "not a request"}

	result = {"id": request.get ("id") if isinstance (request.get ("id"), str)
	                else ""}
	action = request.get ("action")
	ssid = request.get ("ssid")
	password = request.get ("password", "")
	if action not in ("save", "delete"):
		result["invalid"] = "unknown action"
	elif not isinstance (ssid, str) or not 1 <= len (ssid.encode ()) <= 32:
		result["invalid"] = "ssid"
	elif "save" == action and (not isinstance (password, str)
	                           or not valid_wlan_password (password)):
		result["invalid"] = "password"
	else:
		result.update (action=action, ssid=ssid,
		               password=password if "save" == action else "")
	return result


class Hotspot ():
	def __init__ (self, nm:NetworkManager=None, delay:float=HOTSPOT_DELAY,
	              check:float=HOTSPOT_CHECK, hide=(), clock=time.monotonic,
	              config=read_config, dnsmasq=write_dnsmasq,
	              portal:Portal=None, state_file:str=HOTSPOT_STATE_FILE,
	              sleep=time.sleep, request=take_request):
		self.nm = nm or NetworkManager ()
		self.delay = delay
		self.check = check
		# SSIDs treated as unknown (tests: "not in range")
		self.hide = set (hide)
		self.clock = clock
		self.sleep = sleep
		self.config = config
		self.dnsmasq = dnsmasq
		# the captive portal, running only while the hotspot is up
		self.portal = portal if portal is not None else Portal ()
		self.state = StateFile (state_file)
		self.started = time.time () - clock ()
		self.last_good = clock ()
		self.next_check = 0
		self.failures = 0
		self.retry_at = 0
		self.mode = None
		self.cleaned = False
		# SSIDs of connections (for the status page)
		self.ssids = dict ()
		# for the webapp's page WLAN: known and visible WLANs, the
		# answer to the last request, the last new WLAN connected
		self.request = request
		self.extra = dict ()
		self.lists_at = 0
		# (uuid, ssid, when) of a new WLAN to connect
		self.pending = None
		return

	def wall (self, moment:float) -> float:
		return self.started + moment

	def set_mode (self, mode:str, **details):
		if mode in PORTAL_MODES:
			self.portal.start ()
		else:
			self.portal.stop ()

		if mode != self.mode:
			log.info ("%s%s", mode, "".join (" %s=%s" % item for item
			                                  in sorted (details.items ())
			                                  if item[0] in ("network", "ssid",
			                                                 "device", "reason")))
			self.mode = mode
		self.state.write (dict (details, mode=mode, **self.extra))
		return

	def network_ssid (self, connection:str) -> str:
		if connection not in self.ssids:
			values = self.nm.settings ("id " + connection,
			                           ("802-11-wireless.ssid", ))
			self.ssids[connection] = values[0] if values and values[0] 			                         else connection
		return self.ssids[connection]

	def set_client (self, device:str, connection:str, config:dict):
		self.last_good = self.clock ()
		self.failures = 0
		self.set_mode ("client", device=device, ssid=config["ssid"],
		               network=self.network_ssid (connection))
		return

	def known (self, device:str) -> list:
		return [(uuid, ssid) for uuid, ssid in self.nm.known_networks (device)
		        if ssid not in self.hide]

	def device (self, devices:list, config:dict):
		for device in devices:
			if "wifi" == device["type"]:
				return device
		return None

	# tries the known WLANs in range, best signal first; True if one is
	# connected
	def connect_known (self, device:str, known:list) -> bool:
		if not known:
			return False

		visible = self.nm.visible (device, rescan=True)
		candidates = sorted ((visible[ssid], uuid, ssid) for uuid, ssid in known
		                     if ssid in visible)
		for _, uuid, ssid in reversed (candidates):
			log.info ("known WLAN %s in range, connecting", ssid)
			if self.nm.up (uuid, device):
				return True
		return False

	def start_hotspot (self, device:str, config:dict, now:float):
		self.dnsmasq (config["name"])
		if self.nm.make_hotspot (device, config["ssid"]) \
		and self.nm.hotspot_up (device):
			self.failures = 0
			self.next_check = now + self.check
			self.set_mode ("hotspot", ssid=config["ssid"], device=device,
			               address=HOTSPOT_ADDRESS, clients=0,
			               since=self.wall (now))
			return True

		self.failures += 1
		retry = min (self.delay * 2 ** (self.failures - 1), HOTSPOT_RETRY_MAX)
		self.retry_at = now + retry
		self.last_good = now
		self.set_mode ("error", ssid=config["ssid"], device=device,
		               retry=self.wall (self.retry_at))
		return False

	# in the hotspot without devices: back to a known WLAN if one is
	# in range
	def check_back (self, device:str, config:dict, now:float):
		known = self.known (device)
		if not known:
			return

		seen = self.nm.ap_scan (device)
		if seen is not None and not any (ssid in seen for _, ssid in known):
			log.debug ("no known WLAN in range")
			return

		log.info ("looking for known WLANs (%s)",
		          ", ".join (ssid for _, ssid in known))
		self.nm.hotspot_down (device)

		# NetworkManager connects a known WLAN in range by itself; if it
		# does not start that soon, it is tried here
		start = self.clock ()
		connected = False
		while True:
			current = self.find (device)
			state = current["state"] if current else ""
			if state.startswith ("connected") \
			and HOTSPOT_CONNECTION != current["connection"]:
				connected = True
				break

			waited = self.clock () - start
			if waited >= SWITCH_WAIT or (waited >= SWITCH_IDLE
			                             and not state.startswith ("connecting")
			                             and not state.startswith ("deactivating")):
				break
			self.sleep (SWITCH_POLL)

		if not connected:
			connected = self.connect_known (device, known)

		if connected:
			self.set_client (device, self.current_network (device), config)
			return

		log.info ("no known WLAN in range, hotspot again")
		self.start_hotspot (device, config, self.clock ())
		return

	def find (self, device:str):
		for item in self.nm.devices () or []:
			if item["device"] == device:
				return item
		return None

	def current_network (self, device:str) -> str:
		item = self.find (device)
		return item["connection"] if item else ""

	def refresh_lists (self, device:str, config:dict):
		known = sorted ({ssid for _, ssid in self.known (device)},
		                key=str.lower)
		visible = self.nm.visible (device, rescan=False)
		visible.pop (config["ssid"], None)
		self.extra["known"] = known
		self.extra["visible"] = sorted (visible, key=lambda ssid:
		                                -visible[ssid])[:VISIBLE_MAX]
		self.lists_at = self.clock () + LISTS_REFRESH
		return

	# the webapp's request, if there is one; True if one was done
	def handle_request (self) -> bool:
		request = self.request ()
		if request is None:
			return False

		answer = {"id": request["id"], "ok": False,
		          "ssid": request.get ("ssid", "")}
		devices = self.nm.devices ()
		item = self.device (devices or [], None)
		if "invalid" in request:
			log.warning ("invalid WLAN request: %s", request["invalid"])
			answer["error"] = "invalid"
		elif item is None:
			answer["error"] = "no networkmanager" if devices is None \
			                  else "no wlan"
		else:
			self.do_request (request, item, answer)

		self.extra["request"] = dict (answer, at=time.time ())
		if item is not None:
			self.refresh_lists (item["device"], self.config ())
		self.state.write (dict (self.state.written or {}, **self.extra))
		return True

	def do_request (self, request:dict, item:dict, answer:dict):
		device = item["device"]
		ssid = request["ssid"]
		uuids = [uuid for uuid, known in self.nm.known_networks (device)
		         if known == ssid]

		if "delete" == request["action"]:
			if not uuids:
				answer["error"] = "unknown"
				return
			for uuid in uuids:
				result = self.nm.delete_network (uuid)
				if result is not True:
					log.error ("deleting WLAN %s failed: %s", ssid, result)
					answer.update (error="failed", detail=result)
					return
			log.info ("deleted WLAN %s (webapp)", ssid)
			self.ssids.clear ()
			answer.update (ok=True, done="deleted")
			return

		result = self.nm.save_network (device, ssid, request["password"],
		                               uuids[0] if uuids else None)
		if result is not True:
			log.error ("saving WLAN %s failed: %s", ssid, result)
			answer.update (error="failed", detail=result)
			return

		log.info ("%s WLAN %s (webapp)", "changed" if uuids else "saved",
		          ssid)
		answer.update (ok=True, done="changed" if uuids else "saved")

		# connected at once only if the phone has no WLAN; it stays in
		# a WLAN it has (NetworkManager takes the new one when that one
		# is gone)
		in_hotspot = HOTSPOT_CONNECTION == item["connection"]
		if in_hotspot or not item["state"].startswith ("connected"):
			uuid = uuids[0] if uuids else self.uuid_of (device, ssid)
			if uuid:
				self.pending = (uuid, ssid, self.clock () + NEW_WLAN_DELAY)
				answer["next"] = "switch" if in_hotspot else "connect"
		else:
			answer.update (next="stay",
			               network=self.network_ssid (item["connection"]))
		return

	def uuid_of (self, device:str, ssid:str):
		for uuid, known in self.nm.known_networks (device):
			if known == ssid:
				return uuid
		return None

	# the WLAN just saved in the webapp, when it is time
	def connect_pending (self):
		uuid, ssid, at = self.pending
		if self.clock () < at:
			return
		self.pending = None

		config = self.config ()
		item = self.device (self.nm.devices () or [], config)
		if item is None:
			return
		device = item["device"]
		in_hotspot = HOTSPOT_CONNECTION == item["connection"]
		if not in_hotspot and item["state"].startswith ("connected"):
			return

		log.info ("connecting the new WLAN %s", ssid)
		if in_hotspot:
			self.nm.hotspot_down (device)
		connected = self.nm.up (uuid, device)
		self.extra["switch"] = {"ssid": ssid, "ok": connected,
		                        "at": time.time ()}
		if connected:
			self.set_client (device, self.current_network (device), config)
		elif in_hotspot:
			log.info ("connecting %s failed, hotspot again", ssid)
			self.start_hotspot (device, config, self.clock ())
		return

	# a check of the WLAN; the time (s) until the next one
	def step (self) -> float:
		if self.pending:
			self.connect_pending ()
		wait = self.tick ()
		if self.pending:
			wait = max (0, min (wait, self.pending[2] - self.clock ()))
		return wait

	def tick (self):
		now = self.clock ()
		config = self.config ()
		devices = self.nm.devices ()

		if devices is None:
			self.last_good = now
			self.set_mode ("no networkmanager")
			return IDLE_TICK

		item = self.device (devices, config)
		if item is None:
			self.last_good = now
			self.set_mode ("no wlan")
			return IDLE_TICK

		device = item["device"]
		state = item["state"]
		in_hotspot = HOTSPOT_CONNECTION == item["connection"]

		if now >= self.lists_at:
			self.refresh_lists (device, config)

		if not config["hotspot"]:
			if in_hotspot:
				log.info ("hotspot switched off in the configuration")
				self.nm.hotspot_down (device)
			if not self.cleaned:
				self.nm.delete_hotspot ()
				self.cleaned = True
			self.last_good = now
			self.set_mode ("off", device=device, ssid=config["ssid"])
			return HOTSPOT_TICK
		self.cleaned = False

		if in_hotspot:
			self.last_good = now
			if not state.startswith ("connected"):
				self.set_mode ("hotspot starting", device=device,
				               ssid=config["ssid"])
				return HOTSPOT_TICK

			clients = self.nm.stations (device)
			since = self.state.written.get ("since") \
			        if self.state.written else None
			self.set_mode ("hotspot", device=device, ssid=config["ssid"],
			               address=HOTSPOT_ADDRESS, clients=clients,
			               since=since or self.wall (now),
			               next_check=self.wall (self.next_check))

			if now >= self.next_check:
				self.next_check = now + self.check
				if clients:
					log.debug ("%d devices in the hotspot, staying", clients)
				else:
					self.check_back (device, config, now)
			return HOTSPOT_TICK

		if state.startswith ("connected"):
			self.set_client (device, item["connection"], config)
			return HOTSPOT_TICK

		if state.startswith ("unavailable") or state.startswith ("unmanaged"):
			self.last_good = now
			self.set_mode ("no wlan", device=device, reason=state)
			return HOTSPOT_TICK

		# connecting, getting an address, ...: NetworkManager is busy
		if not state.startswith ("disconnected"):
			self.set_mode ("connecting", device=device, ssid=config["ssid"],
			               hotspot_at=self.wall (self.last_good + self.delay))
			return HOTSPOT_TICK

		at = max (self.last_good + self.delay, self.retry_at)
		if now < at:
			self.set_mode ("waiting", device=device, ssid=config["ssid"],
			               hotspot_at=self.wall (at))
			return HOTSPOT_TICK

		# NetworkManager gave up or nothing known is in range
		if self.connect_known (device, self.known (device)):
			self.set_client (device, self.current_network (device), config)
			return HOTSPOT_TICK

		log.info ("no known WLAN in range for %d s, starting the hotspot %s",
		          now - self.last_good, config["ssid"])
		self.start_hotspot (device, config, self.clock ())
		return HOTSPOT_TICK


def run_hotspot (args) -> int:
	hotspot = Hotspot (delay=args.delay, check=args.check, hide=args.hide)
	log.info ("started (hotspot after %d s without a known WLAN, checks every"
	          " %d s%s)", args.delay, args.check,
	          ", ignoring " + ", ".join (args.hide) if args.hide else "")
	while True:
		try:
			wait = hotspot.step ()
		except Exception:
			log.exception ("hotspot check failed")
			wait = HOTSPOT_TICK

		# requests of the webapp in between, then a check at once
		end = time.monotonic () + wait
		while time.monotonic () < end:
			try:
				if hotspot.handle_request ():
					break
			except Exception:
				log.exception ("WLAN request failed")
			time.sleep (min (REQUEST_POLL, max (0, end - time.monotonic ())))


def stop (signum, frame):
	log.info ("stopped")
	sys.exit (0)


def main () -> int:
	parser = argparse.ArgumentParser (description="mDNS name and WLAN hotspot"
	                                  " of telefono")
	parser.add_argument ("--debug", action="store_true")
	commands = parser.add_subparsers (dest="command", required=True)
	commands.add_parser ("mdns", help="publish <name>.local")
	hotspot = commands.add_parser ("hotspot", help="WLAN hotspot when no"
	                               " known WLAN is in range")
	hotspot.add_argument ("--delay", type=float, default=HOTSPOT_DELAY,
	                      help="s without a known WLAN before the hotspot")
	hotspot.add_argument ("--check", type=float, default=HOTSPOT_CHECK,
	                      help="s between looking for known WLANs")
	hotspot.add_argument ("--hide", action="append", default=[],
	                      metavar="SSID", help="treat this WLAN as not in"
	                      " range (for tests)")
	args = parser.parse_args ()

	logging.basicConfig (level=logging.DEBUG if args.debug else logging.INFO,
	                     format="%(levelname)s: %(message)s")
	signal.signal (signal.SIGTERM, stop)

	if "mdns" == args.command:
		return run_mdns (args)
	return run_hotspot (args)


if "__main__" == __name__:
	sys.exit (main ())
