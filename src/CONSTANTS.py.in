#!/usr/bin/python3
# -*- coding: utf-8 -*-

DEBUG = False
LOG_FORMAT = "%(filename)15s:%(lineno)4d (%(levelname)s) %(name)s: %(message)s"

VCS_VERSION = "@vcs_version@"

DATA_DIR = "@pkgdatadir@"

RECORD_DIR = "@pkglocalstatedir@"
RECORD_PREFIX = "recording"
RECORD_SUFFIX = ".wav"

RING_FILE = DATA_DIR + "/ring.wav"
STARTUP_FILE = DATA_DIR + "/startup.wav"
SHUTDOWN_FILE = DATA_DIR + "/shutdown.wav"

RECORD_LIST_FILE = "@pkglocalstatedir@/records.list"
BACKUP_EXT = ".bak"

UPLOAD_DIR = RECORD_DIR

# largest accepted request (HTTP 413 above), uploads are kept in /tmp
# (tmpfs, i.e. RAM) until they are saved: a recording made on the
# phone is at most 21 MB (RECORD_TIME_MAX: 120 s, 44.1 kHz, stereo,
# 16 bit), the largest existing one 39 MB (3:24 min, 48 kHz stereo),
# 50 MiB are about 4:30 min of 48 kHz stereo
UPLOAD_MAX_SIZE = 50 * 1024 * 1024

WEBAPP_EXEC = ("python3", "-m", "telefono.webapp")

FLASK_DEBUG = DEBUG
FLASK_IP = "0.0.0.0"
FLASK_PORT = 5000
FLASK_TEMPLATES = "@templatedir@"
FLASK_STATIC = "@staticdir@"

TIME_FORMAT = "Es ist %k Uhr %-M am %e %B %Y"
DEBUG_TIME_FORMAT = "%F %T %Z(%z) (%s)"

MIN_HOUR = 15
MAX_HOUR = 21

SPEAKER_DELAY = 0.2
SPEAKER_POWERON_DELAY = 2


SOX_BASE = ("play", "-n")
SOX_VOL = ("vol", "-20dB")
SOX_REMIX =  ("remix", "-")
SOX_REPEAT =  ("repeat", "-")

SOX_DIAL = (*SOX_BASE,
            "synth",
            "sin", "425",
            *SOX_VOL, *SOX_REMIX)

SOX_BUSY = (*SOX_BASE,
            "synth", "0.5",
            "sin", "425",
            "pad", "0", "0.5",
            *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_RING = (*SOX_BASE,
            "synth", "1",
            "sin", "425",
            "pad", "0", "4",
            *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_RELEASE = (*SOX_BASE,
               "synth", "0.25",
               "sin", "425",
               "pad", "0", "0.25",
               *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_DIAL_SECONDARY = SOX_DIAL

SOX_DIAL_SPECIAL = (*SOX_BASE,
                    "synth", "0.5",
                    "sin", "425",
                    "pad", "0", "0.05",
                    *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_SIT = (*SOX_BASE,
           "synth", "0.33",
           "sin", "950",
           "sin", "1400",
           "sin", "1800",
           "delay", "0", "0.33", "0.66",
           "pad", "0", "1",
           *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_CONGESTION = (*SOX_BASE,
                  "synth", "0.25",
                  "sin", "425",
                  "pad", "0", "0.25",
                  *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_CALL_WAIT = (*SOX_BASE,
                 "synth", "0.2",
                 "sin", "425",
                 "sin", "425",
                 "delay", "0", "0.4",
                 "pad", "0", "9",
                 *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

# length and pad must be >= 65ms
SOX_NUMBER = lambda low_freq, high_freq: \
             (*SOX_BASE,
              "synth", "0.1",
              "sin", str (low_freq),
              "sin", str (high_freq),
              "pad", "0", "0.1",
              *SOX_VOL, *SOX_REMIX)

SOX_NUMBER_1 = SOX_NUMBER (697, 1209)
SOX_NUMBER_2 = SOX_NUMBER (697, 1336)
SOX_NUMBER_3 = SOX_NUMBER (697, 1477)
SOX_NUMBER_4 = SOX_NUMBER (770, 1209)
SOX_NUMBER_5 = SOX_NUMBER (770, 1336)
SOX_NUMBER_6 = SOX_NUMBER (770, 1477)
SOX_NUMBER_7 = SOX_NUMBER (852, 1209)
SOX_NUMBER_8 = SOX_NUMBER (852, 1336)
SOX_NUMBER_9 = SOX_NUMBER (852, 1477)
SOX_NUMBER_S = SOX_NUMBER (941, 1209)
SOX_NUMBER_0 = SOX_NUMBER (941, 1336)
SOX_NUMBER_R = SOX_NUMBER (941, 1477)
SOX_NUMBER_A = SOX_NUMBER (697, 1633)
SOX_NUMBER_B = SOX_NUMBER (770, 1633)
SOX_NUMBER_C = SOX_NUMBER (852, 1633)
SOX_NUMBER_D = SOX_NUMBER (941, 1633)


FFPLAY_CMD = ("ffplay", "-nodisp", "-autoexit", "-i")
FFPLAY_START = ("-ss", )
FFPLAY_VOLUME = ("-volume", )
FFPLAY_POLL_DELAY = 0.01

FFPLAY_ENV = {
	"XDG_RUNTIME_DIR": "/run/user/1000",
}


ESPEAK_CMD = ("espeak", )
ESPEAK_SPEED = ("-s", )
ESPEAK_AMPLITUDE = ("-a", )
ESPEAK_VOICE = ("-v", )
ESPEAK_TEXT = ("--", )

TTS_SPEED = 140
TTS_AMPLITUDE = 100
TTS_VOICE = "de+f2"


WIND_TIME = 10


MAINLOOP_DELAY = 0.5

# how long the webapp waits for an answer of the main process,
# which only answers between phone actions (one message per main loop)
IPC_TIMEOUT = 3

NO_NUMBER_DELAY = 0.01
NO_NUMBER_TIMEOUT = 40 / NO_NUMBER_DELAY

BUSY_DELAY = 0.01
BUSY_TIMEOUT = 120 / BUSY_DELAY

TONE_DELAY = 0.01
RELEASE_DELAY = 0.01
SAY_DELAY = 0.01

MENU_DELAY = 0.01
OFF_HOOK_DELAY = 0.01

DIAL_IN_USE_DELAY = 0.1
DIAL_SLEEP = 0.01
DIAL_TIMEOUT_DELAY = 0.01
DIAL_TIMEOUT = 200 / DIAL_TIMEOUT_DELAY
DIAL_AUTO_TIMEOUT = 4 / DIAL_TIMEOUT_DELAY

SHUTDOWN_BUTTON_DELAY = 0.5
BUTTON_DELAY = 0.01

RECORD_DELAY = 0.1
RECORD_TIME_MIN = 2 / RECORD_DELAY
RECORD_TIME_MAX = 120 / RECORD_DELAY
