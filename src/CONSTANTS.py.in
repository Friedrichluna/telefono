#!/usr/bin/python3
# -*- coding: utf-8 -*-

DEBUG = False
LOG_FORMAT = "%(filename)15s:%(lineno)4d (%(levelname)s) %(name)s: %(message)s"

VCS_VERSION = "@vcs_version@"

DATA_DIR = "@pkgdatadir@"

RECORD_DIR = "@pkglocalstatedir@"
RECORD_PREFIX = "recording"
RECORD_SUFFIX = ".mp3"
# recordings of older versions, converted to RECORD_SUFFIX at startup
LEGACY_RECORD_SUFFIX = ".wav"

RING_FILE = DATA_DIR + "/ring.wav"
STARTUP_FILE = DATA_DIR + "/startup.wav"
SHUTDOWN_FILE = DATA_DIR + "/shutdown.wav"

RECORD_LIST_FILE = "@pkglocalstatedir@/records.list"
BACKUP_EXT = ".bak"

UPLOAD_DIR = RECORD_DIR

# what happened on the phone (status page of the webapp), one JSON
# object per line, appended by the main process (src/history.py);
# above HISTORY_MAX_SIZE bytes the oldest events are dropped, so that
# HISTORY_KEEP_SIZE are left (an event takes 40 to 200 bytes, so the
# file holds about 5000 to 13000 events)
HISTORY_FILE = "@pkglocalstatedir@/history.jsonl"
HISTORY_MAX_SIZE = 1024 * 1024
HISTORY_KEEP_SIZE = 512 * 1024
# longer texts (text to speech) are shortened in the history
HISTORY_TEXT_MAX = 200

# status page: the newest STATUS_EVENTS events are shown (up to
# STATUS_EVENTS_MAX with "more"), statistics of the last STATUS_DAYS
# days; with the script the page updates every STATUS_REFRESH s
STATUS_EVENTS = 100
STATUS_EVENTS_MAX = 2000
STATUS_DAYS = 7
STATUS_TOP_NUMBERS = 5
STATUS_REFRESH = 10

# hardware configuration of this phone (which inputs are inverted),
# see telefono.conf.example
CONFIG_FILE = "@sysconfdir@/telefono.conf"

# hardware test page (/diagnose): the GPIO registers are read from
# DIAGNOSE_GPIO_MEM (read-only, nothing is claimed or changed); while
# the page is open, a thread samples the inputs every
# DIAGNOSE_SAMPLE_DELAY (the dial pulses are 60 ms long) and stops
# DIAGNOSE_SAMPLE_IDLE s after the page's last update, which comes
# every DIAGNOSE_POLL_INTERVAL s while the page is visible
DIAGNOSE_GPIO_MEM = "/dev/gpiomem"
DIAGNOSE_COMPATIBLE_FILE = "/proc/device-tree/compatible"
DIAGNOSE_SAMPLE_DELAY = 0.01
DIAGNOSE_SAMPLE_IDLE = 3
DIAGNOSE_POLL_INTERVAL = 0.2
# test of the outputs (through the main process, only when it is idle):
# the LED blinks DIAGNOSE_LED_BLINKS times, the relay is switched on
# for SPEAKER_POWERON_DELAY s
DIAGNOSE_LED_BLINKS = 5
DIAGNOSE_LED_BLINK_TIME = 0.2

# largest accepted request (HTTP 413 above), uploads are kept in /tmp
# (tmpfs, i.e. RAM) until they are saved: 50 MiB are about 50 min of
# 128 kbit/s mp3 or 4:30 min of 48 kHz stereo wav
UPLOAD_MAX_SIZE = 50 * 1024 * 1024

# frames read at once while checking an uploaded wav file
UPLOAD_CHECK_FRAMES = 4096

# all recordings are mp3: uploaded and old wav files are encoded with
# MP3_ENCODE_CMD (input file, output file appended); ffmpeg picks the
# nearest rate and channel layout mp3 supports (mono or stereo, at most
# 48 kHz), VBR -q:a 2 is about 190 kbit/s for stereo, 1/7 of 16 bit wav
MP3_ENCODE_OPTIONS = ("-map", "0:a:0", "-map_metadata", "-1",
                      "-c:a", "libmp3lame", "-q:a", "2", "-f", "mp3", "-y")
MP3_ENCODE_CMD = lambda source, input_options=(), output_options=(): \
                 ("ffmpeg", "-hide_banner", "-loglevel", "error",
                  *input_options, "-i", source,
                  *output_options, *MP3_ENCODE_OPTIONS)
# a 3:24 min wav takes about 24 s on the Pi Zero 2W, 50 MiB about 30 s
MP3_ENCODE_TIMEOUT = 300

# checks an mp3 file (appended) without decoding it, counts the frames
MP3_PROBE_CMD = ("ffprobe", "-v", "error", "-select_streams", "a:0",
                 "-count_packets", "-of", "json",
                 "-show_entries", "format=format_name,duration:stream=codec_name,nb_read_packets")
MP3_PROBE_TIMEOUT = 60

# other audio files (browser recordings: webm/opus, mp4/aac; recorder
# apps of phones: m4a, 3gp, amr, ogg, ...) are converted to mp3 with
# ffmpeg; only these demuxers are allowed (no playlists like hls, which
# could open other files) and only the given file itself (file protocol)
AUDIO_INPUT_FORMATS = "mov,matroska,ogg,amr,aac,flac,wav,mp3"
AUDIO_INPUT_OPTIONS = ("-format_whitelist", AUDIO_INPUT_FORMATS,
                       "-protocol_whitelist", "file")
# finds the first audio stream of a file (appended)
AUDIO_PROBE_CMD = ("ffprobe", "-v", "error", *AUDIO_INPUT_OPTIONS,
                   "-select_streams", "a:0", "-of", "json",
                   "-show_entries", "format=format_name:stream=codec_type,codec_name")
# file name extensions the upload accepts (.mp3 is saved as it is,
# everything else is converted)
UPLOAD_EXTENSIONS = (".mp3", ".wav", ".m4a", ".aac", ".mp4", ".3gp", ".3ga",
                     ".amr", ".ogg", ".oga", ".opus", ".webm", ".weba",
                     ".flac")

# recording in the browser (/record): same length as on the phone
# (RECORD_TIME_MIN/MAX), the page stops at the maximum; the server
# allows BROWSER_RECORD_TOLERANCE s more or less (the browser starts
# and stops a bit late) and stops converting after the maximum
BROWSER_RECORD_MIN = 2
BROWSER_RECORD_MAX = 120
BROWSER_RECORD_TOLERANCE = 1

WEBAPP_EXEC = ("python3", "-m", "telefono.webapp")

FLASK_DEBUG = DEBUG
FLASK_IP = "0.0.0.0"
FLASK_PORT = 5000
# browsers only allow the microphone on https pages (or localhost), so
# the webapp is also served over https with a self-signed certificate,
# made by "make install" (openssl); no https without it; an https
# connection is closed when nothing comes for FLASK_HTTPS_TIMEOUT s
# (the TLS handshake runs in the connection's thread)
FLASK_HTTPS_PORT = 5443
FLASK_HTTPS_CERT = "@sysconfdir@/telefono.crt"
FLASK_HTTPS_KEY = "@sysconfdir@/telefono.key"
FLASK_HTTPS_TIMEOUT = 60
FLASK_TEMPLATES = "@templatedir@"
FLASK_STATIC = "@staticdir@"

TIME_FORMAT = "Es ist %k Uhr %-M am %e %B %Y"
DEBUG_TIME_FORMAT = "%F %T %Z(%z) (%s)"

MIN_HOUR = 15
MAX_HOUR = 21

SPEAKER_DELAY = 0.2
SPEAKER_POWERON_DELAY = 2

# volume (webapp page /volume, src/volume.py): the playback volume
# control of the USB card has a channel for the loudspeaker (left, to
# the amplifier the relay switches on) and one for the handset (right),
# see docs/circuit_diagram.png; amixer without -c uses the "default"
# card like the playback (sox, ffplay, espeak), the first control of
# MIXER_CONTROLS the card has is used
MIXER_CMD = ("amixer", )
MIXER_CONTROLS = ("Speaker Playback Volume", "PCM Playback Volume",
                  "Master Playback Volume", "Headphone Playback Volume")
MIXER_SPEAKER_CHANNEL = 0
MIXER_HANDSET_CHANNEL = 1
MIXER_TIMEOUT = 5
# the settings of the page in percent, written by the webapp; without
# the file (or an entry) nothing is changed (the card keeps what
# alsactl restored at boot)
VOLUME_FILE = "@pkglocalstatedir@/volume.json"
# ffplay volume (percent) of the ring without a setting
RING_VOLUME = 70
# test sounds of the page (through the main process, only when idle)
VOLUME_TEST_RING_TIME = 3
VOLUME_TEST_HANDSET_TEXT = "Das ist die Lautstärke im Hörer."
VOLUME_TEST_SPEAKER_TEXT = "Das ist die Lautstärke des Lautsprechers."


SOX_BASE = ("play", "-n")
SOX_VOL = ("vol", "-20dB")
SOX_REMIX =  ("remix", "-")
SOX_REPEAT =  ("repeat", "-")

SOX_DIAL = (*SOX_BASE,
            "synth",
            "sin", "425",
            *SOX_VOL, *SOX_REMIX)

SOX_BUSY = (*SOX_BASE,
            "synth", "0.5",
            "sin", "425",
            "pad", "0", "0.5",
            *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_RING = (*SOX_BASE,
            "synth", "1",
            "sin", "425",
            "pad", "0", "4",
            *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_RELEASE = (*SOX_BASE,
               "synth", "0.25",
               "sin", "425",
               "pad", "0", "0.25",
               *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_DIAL_SECONDARY = SOX_DIAL

SOX_DIAL_SPECIAL = (*SOX_BASE,
                    "synth", "0.5",
                    "sin", "425",
                    "pad", "0", "0.05",
                    *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_SIT = (*SOX_BASE,
           "synth", "0.33",
           "sin", "950",
           "sin", "1400",
           "sin", "1800",
           "delay", "0", "0.33", "0.66",
           "pad", "0", "1",
           *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_CONGESTION = (*SOX_BASE,
                  "synth", "0.25",
                  "sin", "425",
                  "pad", "0", "0.25",
                  *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

SOX_CALL_WAIT = (*SOX_BASE,
                 "synth", "0.2",
                 "sin", "425",
                 "sin", "425",
                 "delay", "0", "0.4",
                 "pad", "0", "9",
                 *SOX_VOL, *SOX_REMIX, *SOX_REPEAT)

# length and pad must be >= 65ms
SOX_NUMBER = lambda low_freq, high_freq: \
             (*SOX_BASE,
              "synth", "0.1",
              "sin", str (low_freq),
              "sin", str (high_freq),
              "pad", "0", "0.1",
              *SOX_VOL, *SOX_REMIX)

SOX_NUMBER_1 = SOX_NUMBER (697, 1209)
SOX_NUMBER_2 = SOX_NUMBER (697, 1336)
SOX_NUMBER_3 = SOX_NUMBER (697, 1477)
SOX_NUMBER_4 = SOX_NUMBER (770, 1209)
SOX_NUMBER_5 = SOX_NUMBER (770, 1336)
SOX_NUMBER_6 = SOX_NUMBER (770, 1477)
SOX_NUMBER_7 = SOX_NUMBER (852, 1209)
SOX_NUMBER_8 = SOX_NUMBER (852, 1336)
SOX_NUMBER_9 = SOX_NUMBER (852, 1477)
SOX_NUMBER_S = SOX_NUMBER (941, 1209)
SOX_NUMBER_0 = SOX_NUMBER (941, 1336)
SOX_NUMBER_R = SOX_NUMBER (941, 1477)
SOX_NUMBER_A = SOX_NUMBER (697, 1633)
SOX_NUMBER_B = SOX_NUMBER (770, 1633)
SOX_NUMBER_C = SOX_NUMBER (852, 1633)
SOX_NUMBER_D = SOX_NUMBER (941, 1633)


FFPLAY_CMD = ("ffplay", "-nodisp", "-autoexit", "-i")
FFPLAY_START = ("-ss", )
FFPLAY_VOLUME = ("-volume", )
FFPLAY_DURATION = ("-t", )
FFPLAY_POLL_DELAY = 0.01
# restart ffplay, if its position doesn't change for this many seconds
# (startup takes 1 s, with a cold cache after boot 4.5 s)
FFPLAY_STALL_TIMEOUT = 10
FFPLAY_STALL_RETRIES = 3
FFPLAY_KILL_TIMEOUT = 1

FFPLAY_ENV = {
	"XDG_RUNTIME_DIR": "/run/user/1000",
}


ESPEAK_CMD = ("espeak", )
ESPEAK_SPEED = ("-s", )
ESPEAK_AMPLITUDE = ("-a", )
ESPEAK_VOICE = ("-v", )
ESPEAK_TEXT = ("--", )

TTS_SPEED = 140
TTS_AMPLITUDE = 100
TTS_VOICE = "de+f2"


WIND_TIME = 10


MAINLOOP_DELAY = 0.5

# how long the webapp waits for an answer of the main process,
# which only answers between phone actions (one message per main loop)
IPC_TIMEOUT = 3

NO_NUMBER_DELAY = 0.01
NO_NUMBER_TIMEOUT = 40 / NO_NUMBER_DELAY

BUSY_DELAY = 0.01
BUSY_TIMEOUT = 120 / BUSY_DELAY

TONE_DELAY = 0.01
RELEASE_DELAY = 0.01
SAY_DELAY = 0.01

MENU_DELAY = 0.01
OFF_HOOK_DELAY = 0.01

DIAL_IN_USE_DELAY = 0.1
DIAL_SLEEP = 0.01
DIAL_TIMEOUT_DELAY = 0.01
DIAL_TIMEOUT = 200 / DIAL_TIMEOUT_DELAY
DIAL_AUTO_TIMEOUT = 4 / DIAL_TIMEOUT_DELAY

SHUTDOWN_BUTTON_DELAY = 0.5
BUTTON_DELAY = 0.01

RECORD_DELAY = 0.1
RECORD_TIME_MIN = 2 / RECORD_DELAY
RECORD_TIME_MAX = 120 / RECORD_DELAY

# recordings are encoded while they are made: the raw 16 bit samples
# go through a pipe into ffmpeg, which writes the mp3 (appended)
RECORD_ENCODE_CMD = lambda channels, rate: \
                    ("ffmpeg", "-hide_banner", "-loglevel", "error",
                     "-f", "s16le", "-ac", str (channels), "-ar", str (rate),
                     "-i", "pipe:0", *MP3_ENCODE_OPTIONS)
# the pipe buffers the first seconds while ffmpeg starts (about 0.5 s),
# 1 MiB (the default maximum) are 6 s of 44.1 kHz stereo
RECORD_PIPE_SIZE = 1024 * 1024
# ffmpeg is about 8 times faster than real time, so it is done
# soon after the input ends
RECORD_ENCODE_TIMEOUT = 30
